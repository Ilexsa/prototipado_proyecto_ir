digraph A {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.22, ranksep=0.35, pad=0.3, newrank=true];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9.5, fillcolor="#FFFFFF", color="#5A5A5A", margin="0.1,0.05", width=1.65, height=0.55];
  edge [color="#555555", arrowsize=0.6];

  entrada [label="Solicitud\nWeb · Copilot ·\nLote del rezago", shape=note, fillcolor="#FFF7E0", width=1.3];
  orq [label="AG-00\nORQUESTADOR\n\nClasifica intención\nPlanifica y delega\nConsolida resultados\nControla costos", fillcolor="#0078D4", fontcolor="white", color="#005A9E", width=1.7, height=2.6, fontsize=10];
  entrada -> orq;

  subgraph cluster_c1 { label="Comprensión"; style="rounded,filled"; fillcolor="#EAF3FC"; color="#0078D4"; fontsize=10;
    a01 [label="AG-01 Clasificador\ndocumental"]; a11 [label="AG-11 Procesos\ny flujo"]; a14 [label="AG-14 Terminología\ny glosario"]; }
  subgraph cluster_c2 { label="Calidad de redacción"; style="rounded,filled"; fillcolor="#EAF3FC"; color="#0078D4"; fontsize=10;
    a02 [label="AG-02 Ortografía\ny gramática"]; a03 [label="AG-03 Redacción y\nlenguaje claro"]; a04 [label="AG-04 Estructura\ny plantilla"]; }
  subgraph cluster_c3 { label="Vigencia y cumplimiento"; style="rounded,filled"; fillcolor="#EAF3FC"; color="#0078D4"; fontsize=10;
    a05 [label="AG-05 Vigencia y\nobsolescencia"]; a06 [label="AG-06 Cumplimiento\nnormativo"]; a12 [label="AG-12 Controles\ny riesgos"]; a13 [label="AG-13 Datos\npersonales"]; }
  subgraph cluster_c4 { label="Coherencia del corpus"; style="rounded,filled"; fillcolor="#EAF3FC"; color="#0078D4"; fontsize=10;
    a07 [label="AG-07 Coherencia\ninter-documental"]; a08 [label="AG-08 Duplicidad\ny similitud"]; a09 [label="AG-09 Referencias\ny adjuntos"]; a10 [label="AG-10 Roles y\nresponsabilidades"]; }
  subgraph cluster_c5 { label="Generación y consulta"; style="rounded,filled"; fillcolor="#EAF3FC"; color="#0078D4"; fontsize=10;
    a15 [label="AG-15 Redactor\nde propuesta"]; a16 [label="AG-16 Consulta RAG\nconversacional"]; }

  a01 -> a11 -> a14 [style=invis]; a02 -> a03 -> a04 [style=invis]; a05 -> a06 -> a12 -> a13 [style=invis];
  a07 -> a08 -> a09 -> a10 [style=invis]; a15 -> a16 [style=invis];
  orq -> {a01 a02 a05 a07 a15} [style=dashed];

  qa [label="AG-17\nVERIFICADOR\nDE CALIDAD\n\nValida evidencia\ny citas\nDescarta falsos\npositivos\nPuntúa confianza", fillcolor="#005A9E", fontcolor="white", width=1.6, height=2.6, fontsize=10];
  {a14 a04 a13 a10 a16} -> qa [style=dashed];
  salida [label="Informe consolidado\nde hallazgos\n(JSON + vista web)\n↓\nRevisión humana\n(HITL)", shape=note, fillcolor="#E8F6EA", width=1.6];
  qa -> salida;
}
